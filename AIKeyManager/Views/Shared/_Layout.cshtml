<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AIKeyManager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AIKeyManager.styles.css" asp-append-version="true" />

    <style>
            :root {
                --bg-primary: #0f0f1a;
                --bg-secondary: #1a1a2e;
                --bg-card: rgba(255, 255, 255, 0.04);
                --border-color: rgba(255, 255, 255, 0.08);
                --text-primary: #e2e8f0;
                --text-muted: rgba(255, 255, 255, 0.45);
                --accent: #6c63ff;
                --accent-soft: rgba(108, 99, 255, 0.15);
            }

            html, body {
                background: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 60%, #16213e 100%);
                min-height: 100vh;
                color: var(--text-primary);
            }

            /* Kartice */
            .card {
                background: var(--bg-card);
                border: 1px solid var(--border-color);
                border-radius: 14px;
                backdrop-filter: blur(12px);
                color: var(--text-primary);
            }

            .card-header {
                background: rgba(255, 255, 255, 0.05);
                border-bottom: 1px solid var(--border-color);
                border-radius: 14px 14px 0 0 !important;
            }

            /* Tabele */
            .table {
                color: var(--text-primary);
            }

                .table thead th {
                    color: rgba(255, 255, 255, 0.6);
                    font-size: 0.78rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    border-bottom: 1px solid var(--border-color);
                }

                .table td {
                    border-color: var(--border-color);
                    vertical-align: middle;
                }

            .table-hover tbody tr:hover {
                background: rgba(255, 255, 255, 0.04);
            }

            /* Forme */
            .form-control, .form-select {
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid var(--border-color);
                color: var(--text-primary);
                border-radius: 8px;
            }

                .form-control:focus, .form-select:focus {
                    background: rgba(255, 255, 255, 0.09);
                    border-color: var(--accent);
                    color: var(--text-primary);
                    box-shadow: 0 0 0 3px rgba(108, 99, 255, 0.2);
                }

                .form-control::placeholder {
                    color: var(--text-muted);
                }

            .form-label {
                color: rgba(255, 255, 255, 0.65);
                font-size: 0.875rem;
            }

            /* Input dropdown options */
            .form-select option {
                background: #1a1a2e;
                color: var(--text-primary);
            }

            /* Dugmad */
            .btn-primary {
                background: linear-gradient(135deg, #6c63ff, #a78bfa);
                border: none;
                border-radius: 8px;
                font-weight: 600;
            }

                .btn-primary:hover {
                    background: linear-gradient(135deg, #5a52d5, #9070e8);
                    border: none;
                }

            .btn-outline-secondary {
                border-color: var(--border-color);
                color: var(--text-primary);
            }

                .btn-outline-secondary:hover {
                    background: rgba(255, 255, 255, 0.08);
                    color: var(--text-primary);
                    border-color: rgba(255, 255, 255, 0.2);
                }

            .btn-outline-danger {
                border-color: rgba(239, 68, 68, 0.5);
                color: #f87171;
            }

                .btn-outline-danger:hover {
                    background: rgba(239, 68, 68, 0.15);
                    color: #f87171;
                    border-color: rgba(239, 68, 68, 0.7);
                }

            /* Badge */
            .badge.bg-success {
                background: rgba(34, 197, 94, 0.2) !important;
                color: #4ade80;
                border: 1px solid rgba(34, 197, 94, 0.3);
            }

            .badge.bg-danger {
                background: rgba(239, 68, 68, 0.2) !important;
                color: #f87171;
                border: 1px solid rgba(239, 68, 68, 0.3);
            }

            .badge.bg-primary {
                background: rgba(108, 99, 255, 0.2) !important;
                color: #a78bfa;
                border: 1px solid rgba(108, 99, 255, 0.3);
            }

            .badge.bg-info {
                background: rgba(6, 182, 212, 0.2) !important;
                color: #67e8f9;
                border: 1px solid rgba(6, 182, 212, 0.3);
            }

            .badge.bg-warning {
                background: rgba(234, 179, 8, 0.2) !important;
                color: #fbbf24;
                border: 1px solid rgba(234, 179, 8, 0.3);
            }

            /* Alert */
            .alert-success {
                background: rgba(34, 197, 94, 0.1);
                border: 1px solid rgba(34, 197, 94, 0.3);
                color: #4ade80;
                border-radius: 10px;
            }

            .alert-danger {
                background: rgba(239, 68, 68, 0.1);
                border: 1px solid rgba(239, 68, 68, 0.3);
                color: #f87171;
                border-radius: 10px;
            }

            /* Footer */
            footer {
                border-color: var(--border-color) !important;
                color: var(--text-muted) !important;
            }

                footer a {
                    color: var(--accent) !important;
                }

            /* Links */
            a {
                color: #a78bfa;
            }

                a:hover {
                    color: #c4b5fd;
                }

            /* Moji API keyevi i Nedavna aktivnost kartice */
            .bg-light {
                background: rgba(255, 255, 255, 0.05) !important;
            }

            .text-muted {
                color: var(--text-muted) !important;
            }

            code {
                color: #a78bfa;
                background: rgba(108, 99, 255, 0.1);
                padding: 2px 6px;
                border-radius: 4px;
            }

            .table > :not(caption) > * > * {
                background-color: transparent;
                color: var(--text-primary);
            }

            tbody, thead, tfoot, tr, td, th {
                background-color: transparent !important;
                border-color: var(--border-color) !important;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-body sticky-top" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand fw-bold fs-2 me-4" href="/">🔑 AIKeyManager</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto fs-5">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-semibold @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" href="/Admin">
                                        <i class="bi bi-speedometer2 text-info me-1"></i>Admin Panel
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fw-semibold @(ViewContext.RouteData.Values["action"]?.ToString() == "Providers" ? "active" : "")" href="/Admin/Providers">
                                        <i class="bi bi-hdd-network text-info me-1"></i>Provideri
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fw-semibold @(ViewContext.RouteData.Values["action"]?.ToString() == "AIModels" ? "active" : "")" href="/Admin/AIModels">
                                        <i class="bi bi-cpu text-info me-1"></i>Modeli
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fw-semibold @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")" href="/Admin/Users">
                                        <i class="bi bi-people text-info me-1"></i>Korisnici
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-semibold @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" href="/User/Dashboard">
                                        <i class="bi bi-speedometer2 text-info me-1"></i>Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fw-semibold @(ViewContext.RouteData.Values["action"]?.ToString() == "ApiKeys" ? "active" : "")" href="/User/ApiKeys">
                                        <i class="bi bi-key text-info me-1"></i>API Keyevi
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fw-semibold @(ViewContext.RouteData.Values["action"]?.ToString() == "Search" ? "active" : "")" href="/User/Search">
                                        <i class="bi bi-search text-info me-1"></i>Pretraga
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav fs-5">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                                    <li>
                                        <a class="dropdown-item" href="@(User.IsInRole("Admin") ? "/Admin" : "/User/Dashboard")">
                                            <i class="bi bi-house-door me-2"></i>Moj nalog
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="/Auth/Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Odjavi se
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Auth/Login">Prijavi se</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Auth/Register">Registruj se</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AIKeyManager - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>