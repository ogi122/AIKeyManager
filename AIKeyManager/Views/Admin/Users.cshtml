@model IEnumerable<AIKeyManager.Models.User>

@{
    ViewData["Title"] = "Korisnici";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👥 Korisnici</h2>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <a href="/Admin" class="btn btn-secondary">← Nazad</a>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Kreiran</th>
                        <th>Status</th>
                        <th>Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.UserId</td>
                            <td><strong>@user.Username</strong></td>
                            <td>@user.Email</td>
                            <td>
                                @if (user.Role?.RoleName == "Admin")
                                {
                                    <span class="badge bg-danger">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">User</span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Aktivan</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Neaktivan</span>
                                }
                            </td>
                            <td>
                                <form method="post" action="/Admin/ToggleUser" style="display:inline">
                                    <input type="hidden" name="id" value="@user.UserId" />
                                    <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-warning" : "btn-success")">
                                        @(user.IsActive ? "Deaktiviraj" : "Aktiviraj")
                                    </button>
                                </form>

                                <form method="post" action="/Admin/DeleteUser" style="display:inline" onsubmit="return confirm('Sigurno obrisati ovog korisnika?');">
                                    <input type="hidden" name="id" value="@user.UserId" />
                                    <button type="submit" class="btn btn-sm btn-danger">Obriši</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
