@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registracija - AIKeyManager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            body {
                background: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 50%, #16213e 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .register-card {
                background: rgba(255,255,255,0.05);
                border: 1px solid rgba(255,255,255,0.1);
                border-radius: 16px;
                padding: 40px;
                width: 100%;
                max-width: 420px;
                backdrop-filter: blur(10px);
            }

                .register-card h2 {
                    color: #fff;
                    font-weight: 700;
                    margin-bottom: 8px;
                }

                .register-card p {
                    color: rgba(255,255,255,0.5);
                    margin-bottom: 30px;
                }

            .form-control {
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.15);
                color: #fff;
                border-radius: 8px;
                padding: 12px 16px;
            }

                .form-control:focus {
                    background: rgba(255,255,255,0.12);
                    border-color: #6c63ff;
                    color: #fff;
                    box-shadow: 0 0 0 3px rgba(108,99,255,0.2);
                }

            .form-label {
                color: rgba(255,255,255,0.7);
            }

            .btn-primary {
                background: linear-gradient(135deg, #6c63ff, #a78bfa);
                border: none;
                border-radius: 8px;
                padding: 12px;
                font-weight: 600;
                width: 100%;
            }

                .btn-primary:hover {
                    background: linear-gradient(135deg, #5a52d5, #9070e8);
                }

            .logo {
                font-size: 2rem;
                margin-bottom: 16px;
            }

            a {
                color: #a78bfa;
            }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="logo">🔑</div>
        <h2>Kreirajte nalog</h2>
        <p>Pridružite se AIKeyManager platformi</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" name="username" class="form-control" placeholder="vaseime" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Email adresa</label>
                <input type="email" name="email" class="form-control" placeholder="vas@email.com" required />
            </div>
            <div class="mb-4">
                <label class="form-label">Lozinka</label>
                <input type="password" name="password" class="form-control" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn btn-primary">Registruj se</button>
        </form>

        <div class="text-center mt-3">
            <small style="color: rgba(255,255,255,0.5)">Već imate nalog? <a href="/Auth/Login">Prijavite se</a></small>
        </div>
    </div>
</body>
</html>